# Copy to .env (gitignored). launcher/build.rs bakes these into the launcher at build time;
# a variable set in the shell wins. Empty means not configured.
HORIZON_MSA_CLIENT_ID=
HORIZON_CURSEFORGE_API_KEY=
# GitHub sign-in for offline play: an OAuth app with "Enable Device Flow" ticked.
HORIZON_GITHUB_CLIENT_ID=
# Google sign-in for offline play: an OAuth client of type "TV and Limited Input devices".
HORIZON_GOOGLE_CLIENT_ID=
HORIZON_GOOGLE_CLIENT_SECRET=
# 1: this build never replaces itself with upstream's releases (a fork's own builds).
HORIZON_LAUNCHER_NO_SELF_UPDATE=
